{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laadheld",
  "main": "worker/public.mjs",
  "account_id": "90c60240a63503cadd817e6b7cf011c4",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true
  },
  "build": {
    "command": "npm run build"
  }
}
